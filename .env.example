PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/etm
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Super Admin Initial Credentials (Required)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your_strong_super_admin_password_min_8_chars

# Email Service (Nodemailer / Gmail SMTP)
# For Gmail: Use your Gmail address and a 16-character Google App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Employee Training Management" <your_email@gmail.com>

# Frontend Client URL (for invite & reset password links and CORS)
FRONTEND_URL=http://localhost:5173

